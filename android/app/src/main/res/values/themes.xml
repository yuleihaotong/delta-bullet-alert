<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础主题：深色高级感，全局 IBM Plex Sans -->
    <style name="Theme.DeltaBulletAlert" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_regular</item>
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/gold</item>
        <item name="colorControlActivated">@color/gold</item>
        <item name="colorControlHighlight">@color/card_border</item>
        <item name="materialButtonStyle">@style/Widget.Delta.Button</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- QQ 通话式全屏来电界面主题（锁屏亮屏由 Manifest 的 showWhenLocked/turnScreenOn 提供） -->
    <style name="Theme.DeltaBulletAlert.Call" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_regular</item>
    </style>

    <!-- 按钮样式：主按钮=高级金 -->
    <style name="Widget.Delta.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Delta.Button.Primary" parent="Widget.Delta.Button">
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">#1A1405</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Delta.Button.Ghost" parent="Widget.Delta.Button">
        <item name="backgroundTint">@color/card_soft</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Delta.Button.Danger" parent="Widget.Delta.Button">
        <item name="backgroundTint">@color/danger_bg</item>
        <item name="strokeColor">#4A2A33</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- 来电界面 接听/挂断 按钮（胶囊形） -->
    <style name="Widget.Delta.CallButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:elevation">6dp</item>
    </style>
</resources>
