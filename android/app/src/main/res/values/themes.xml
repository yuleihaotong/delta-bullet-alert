    <!-- ==================================================================
         通用组件样式（颜色全部走主题属性）
         ================================================================== -->
    <style name="Widget.Delta.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Delta.Button.Primary" parent="Widget.Delta.Button">
        <item name="backgroundTint">?attr/appPrimary</item>
        <item name="android:textColor">?attr/appOnPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Delta.Button.Ghost" parent="Widget.Delta.Button">
        <item name="backgroundTint">?attr/appCardSoft</item>
        <item name="strokeColor">?attr/appCardBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
    </style>

    <style name="Widget.Delta.Button.Danger" parent="Widget.Delta.Button">
        <item name="backgroundTint">?attr/appDangerBg</item>
        <item name="strokeColor">?attr/appDangerStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">?attr/appDanger</item>
    </style>

    <!-- 来电界面 接听/挂断 按钮（胶囊形） -->
    <style name="Widget.Delta.CallButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:elevation">6dp</item>
    </style>

    <!-- QQ 通话式全屏来电界面主题（锁屏亮屏由 Manifest 的 showWhenLocked/turnScreenOn 提供；
         实际颜色主题在代码里按用户选择 setTheme 覆盖） -->
    <style name="Theme.DeltaBulletAlert.Call" parent="Theme.DeltaBulletAlert">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">?attr/appBgDeep</item>
    </style>
