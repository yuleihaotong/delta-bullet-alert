<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBgDeep"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶部留白（避开状态栏/前置摄像头） -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <TextView
        android:id="@+id/callTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/ibm_plex_sans_bold"
        android:letterSpacing="0.04"
        android:text="买入提醒"
        android:textColor="?attr/appBuy"
        android:textSize="31sp" />

    <TextView
        android:id="@+id/callDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="提醒详情"
        android:textColor="?attr/appTextSecondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/callFrom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="来自 三角洲子弹提醒 · devlan"
        android:textColor="?attr/appFaint"
        android:textSize="12sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnswer"
            style="@style/Widget.Delta.CallButton"
            android:layout_width="120dp"
            android:layout_height="58dp"
            android:text="接听"
            app:backgroundTint="#12A06B"
            app:icon="@drawable/ic_phone"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDecline"
            style="@style/Widget.Delta.CallButton"
            android:layout_width="120dp"
            android:layout_height="58dp"
            android:layout_marginStart="24dp"
            android:text="挂断"
            app:backgroundTint="#D64545"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
